{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog-moments",
	"main": "src/index.js",
	"compatibility_date": "2026-09-30",
	"vars": {
		"ALLOWED_ORIGINS": "https://zhaowenhai.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blog-moments",
			"database_id": "613539b8-bd81-4ccd-a825-78b6c4168da0",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "blog-images"
		}
	],
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	}
}